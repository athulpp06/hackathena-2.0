# ==============================================================================
# LeakedIn — Environment Configuration Template
# All fields are OPTIONAL. The application runs 100% offline with zero configuration.
# ==============================================================================

# Google Gemini Multimodal Vision API Key (Optional)
# If provided, enables Gemini 1.5 Flash for image and semantic reasoning.
# If omitted, LeakedIn automatically operates with the built-in zero-config offline heuristics.
GEMINI_API_KEY=

# Telegram Bot Token (Optional)
# Required only if you are running the Telegram bot (bots/telegram_bot.py).
TELEGRAM_BOT_TOKEN=

# Reputation Database Custom Path (Optional)
# Defaults to backend/app/db/reputation.db
REPUTATION_DB_PATH=backend/app/db/reputation.db

# Custom Frontend API Base URL (Optional)
# Defaults to same-origin ("") when served behind FastAPI or Nginx.
LEAKEDIN_API_BASE=
