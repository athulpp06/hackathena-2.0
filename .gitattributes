# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.svg text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.joblib binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.docx binary
*.pdf binary
*.woff2 binary
